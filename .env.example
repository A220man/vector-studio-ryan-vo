# Database
DATABASE_URL=sqlite:///./data/vector_studio.db

# Security
SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC / Keycloak
OIDC_ENABLED=true
OIDC_CLIENT_ID=vector-studio
OIDC_CLIENT_SECRET=vector-studio-secret
OIDC_ISSUER_URL=http://localhost:8080/realms/vector-studio
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_LOGOUT_URI=http://localhost:5173

# LLM
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]